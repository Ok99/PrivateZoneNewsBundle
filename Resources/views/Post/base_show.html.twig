{% extends 'Ok99PrivateZoneBundle:CRUD:base_show.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/ok99privatezone/js/jquery.fancybox.min.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/ok99privatezone/css/jquery.fancybox.min.css') }}" />
{% endblock %}

{% block show %}
    <div class="sonata-ba-view">
        <div class="row">
            <div class="col-md-4">
                <div class="box box-primary">
                    <div class="box-body">
                        <p class="text-muted text-center">{{ object.perex }}</p>
                        {% if object.image is not null or object.postHasImages|length > 0 %}
                            <div class="advert--attachments margin-bottom">
                                {% set mainImage = object.image ? object.image : object.postHasImages[0].media %}
                                {% set mainThumbWidth = not mainImage.width or mainImage.height > mainImage.width ? 10000 : 1280 %}
                                {% set MainThumbHeight = not mainImage.width or mainImage.height > mainImage.width ? 960 : 10000 %}
                                <a class="advert--hero_attachment" data-fancybox="advert_{{ object.id }}" href="{% path mainImage, 'reference' %}">
                                    <img src="{{ path('symbio_webtools_thumbnail_ratio', { 'width': mainThumbWidth, 'height': MainThumbHeight, 'path': mainImage|mediaPath }) }}" alt="">
                                </a>
                                {% if object.postHasImages|length > 0 and (object.image or object.postHasImages|length > 1) %}
                                    <div class="advert--attachments-side">
                                        {% set maxCountImagesInGallery = object.image is not null ? 4 : 5 %}
                                        {% for postHasImage in object.postHasImages %}
                                            {% set image = postHasImage.media %}
                                            {% if object.image or loop.index > 1 %}
                                                {% set thumbWidth = not image.width or image.height > image.width ? 10000 : 400 %}
                                                {% set thumbHeight = not image.width or image.height > image.width ? 400 : 10000 %}

                                                {% if loop.index < maxCountImagesInGallery %}
                                                    <a data-fancybox="advert_{{ object.id }}" href="{% path image, 'reference' %}">
                                                        <img src="{{ path('symbio_webtools_thumbnail_ratio', { 'width': thumbWidth, 'height': thumbHeight, 'path': image|mediaPath }) }}" alt="Photo">
                                                    </a>
                                                {% elseif loop.index == maxCountImagesInGallery %}
                                                    <a data-fancybox="advert_{{ object.id }}" href="{% path image, 'reference' %}" class="thumb thumb--more">
                                                        <img src="{{ path('symbio_webtools_thumbnail_ratio', { 'width': thumbWidth, 'height': thumbHeight, 'path': image|mediaPath }) }}" alt="Photo">

                                                        {% if loop.length > maxCountImagesInGallery %}
                                                            <div class="thumb-overlay">
                                                                <div class="thumb-overlay-inner">
                                                                    <div class="count">+{{ loop.length - maxCountImagesInGallery }}</div>
                                                                    <div class="text">Zobrazit galerii</div>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    </a>
                                                {% elseif loop.index > maxCountImagesInGallery %}
                                                    <a style="display: none;" data-fancybox="advert_{{ object.id }}" href="{% path image, 'reference' %}">
                                                        <img src="{{ path('symbio_webtools_thumbnail_ratio', { 'width': thumbWidth, 'height': thumbHeight, 'path': image|mediaPath }) }}" alt="Photo">
                                                    </a>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <ul class="list-group list-group-unbordered">
                            <li class="list-group-item">
                                <b><i class="fa fa-calendar margin-r-5"></i> Datum</b>
                                <a class="pull-right">{{ object.publishDate|date('j. n. Y H:i') }}</a>
                            </li>
                            <li class="list-group-item">
                                <b><i class="fa fa-user margin-r-5"></i> Autor</b>
                                <a class="pull-right" href="{{ path('admin_privatezonecore_user_address_book_show', { 'id': object.createdBy.id }) }}">{{ object.createdBy.name }}</a>
                            </li>
                            {% if object.postHasFiles|length > 0 %}
                                {% for postHasFile in object.postHasFiles %}
                                    <li class="list-group-item">
                                        <b><i class="fa fa-file margin-r-5"></i> Příloha</b>
                                        <a class="pull-right" href="{{ path('sonata_media_download', {'id': postHasFile.media.id}) }}">{{ postHasFile.media.name }}</a>
                                    </li>
                                {% endfor %}
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class=" box box-primary">
                    <div class="box-body">
                        <h2>{{ object.title }}</h2>
                        <br/>
                        {{ object.content|raw }}
                    </div>
                </div>
           </div>
        </div>
    </div>
{% endblock %}
